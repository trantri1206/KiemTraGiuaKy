@using _2380600189.Exams.Dto
@model ExamResultDto
@{
    ViewBag.Title = "Chi tiết bài làm: " + Model.CandidateName;
    var p5 = Model.Questions.Count(q => q.PartNumber == 5 && q.IsCorrect);
    var p6 = Model.Questions.Count(q => q.PartNumber == 6 && q.IsCorrect);
    var p7 = Model.Questions.Count(q => q.PartNumber == 7 && q.IsCorrect);
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark font-weight-bold">
                    <i class="fas fa-file-signature text-info mr-2"></i>Chi Tiết Bài Làm: @Model.CandidateName
                </h1>
            </div>
            <div class="col-sm-6 text-right">
                <a asp-action="Detail" asp-route-id="@(string.IsNullOrWhiteSpace(Model.CandidateCode) ? Model.CandidateName : Model.CandidateCode)" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left mr-1"></i> Quay lại lịch sử thí sinh
                </a>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        <!-- Score & Attempt Info Card -->
        <div class="card card-outline card-success shadow-sm mb-4" style="border-radius: 12px;">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-md-7">
                        <h4 class="font-weight-bold text-dark mb-1">Đề thi: @Model.ExamTitle</h4>
                        <div class="text-secondary small mb-3">
                            <span class="mr-3"><i class="fas fa-user mr-1 text-primary"></i>Thí sinh: <strong>@Model.CandidateName</strong></span>
                            <span class="mr-3"><i class="fas fa-id-card mr-1 text-info"></i>MSSV: <strong>@Model.CandidateCode</strong></span>
                            <span><i class="fas fa-clock mr-1 text-secondary"></i>Thời lượng làm bài: <strong>@Model.DurationSpent</strong></span>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge badge-success px-3 py-2 mr-2 font-weight-bold">
                                <i class="fas fa-check-circle mr-1"></i>@Model.TotalCorrect Đúng
                            </span>
                            <span class="badge badge-danger px-3 py-2 mr-2 font-weight-bold">
                                <i class="fas fa-times-circle mr-1"></i>@Model.TotalWrong Sai
                            </span>
                            <span class="badge badge-secondary px-3 py-2 mr-2 font-weight-bold">
                                <i class="fas fa-minus-circle mr-1"></i>@Model.TotalSkipped Bỏ qua
                            </span>
                            <span class="badge badge-info px-3 py-2 font-weight-bold">
                                <i class="fas fa-percentage mr-1"></i>Chính xác: @Model.Percentage%
                            </span>
                        </div>
                    </div>
                    <div class="col-md-5 text-md-right mt-3 mt-md-0">
                        <div class="p-3 bg-light rounded text-center d-inline-block border">
                            <div class="text-muted small font-weight-bold text-uppercase">ĐIỂM TOEIC READING ĐẠT ĐƯỢC</div>
                            <div class="display-4 font-weight-bold text-success my-1">
                                @Model.Score <span class="text-muted" style="font-size: 1.25rem;">/ 495</span>
                            </div>
                            <div class="small text-secondary">Part 5: <strong>@p5/30</strong> • Part 6: <strong>@p6/16</strong> • Part 7: <strong>@p7/54</strong></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Questions List with Student Answers -->
        <h5 class="font-weight-bold text-dark mb-3">
            <i class="fas fa-list-ol mr-2 text-primary"></i>Chi Tiết Từng Câu Hỏi & Lựa Chọn Của Thí Sinh
        </h5>

        @foreach (var q in Model.Questions)
        {
            var isCorrect = q.IsCorrect;
            var isSkipped = q.IsSkipped;
            var borderClass = isCorrect ? "border-success" : (isSkipped ? "border-secondary" : "border-danger");

            <div class="card shadow-sm mb-3 @borderClass" style="border-radius: 10px; border-left-width: 6px;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <span class="badge badge-light border font-weight-bold mr-2">Part @q.PartNumber</span>
                            <strong class="text-dark">Câu @q.QuestionNumber:</strong>
                        </div>
                        <div>
                            @if (isCorrect)
                            {
                                <span class="badge badge-success px-3 py-1 font-weight-bold"><i class="fas fa-check mr-1"></i>ĐÚNG (+ điểm)</span>
                            }
                            else if (isSkipped)
                            {
                                <span class="badge badge-secondary px-3 py-1 font-weight-bold"><i class="fas fa-minus mr-1"></i>CHƯA LÀM</span>
                            }
                            else
                            {
                                <span class="badge badge-danger px-3 py-1 font-weight-bold"><i class="fas fa-times mr-1"></i>SAI</span>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(q.PassageContent))
                    {
                        <div class="p-3 bg-light rounded small mb-3 border text-secondary" style="max-height: 200px; overflow-y: auto;">
                            @if (!string.IsNullOrWhiteSpace(q.PassageTitle))
                            {
                                <strong class="text-dark d-block mb-1">@q.PassageTitle</strong>
                            }
                            <div style="white-space: pre-line;">@q.PassageContent</div>
                        </div>
                    }

                    <div class="font-weight-bold text-dark mb-3" style="font-size: 1.05rem;">@q.Content</div>

                    <!-- 4 Choices -->
                    <div class="row">
                        @foreach (var opt in q.Options)
                        {
                            var isCandidatePick = q.SelectedOptionId == opt.Id;
                            var isThisCorrect = opt.IsCorrect;

                            string optStyle = "background: #F8FAFC; border: 1px solid #E2E8F0;";
                            string badgeHtml = "";

                            if (isThisCorrect)
                            {
                                optStyle = "background: #ECFDF5; border: 2px solid #10B981; font-weight: bold; color: #065F46;";
                                badgeHtml = "<span class='badge badge-success ml-2'><i class='fas fa-check mr-1'></i>Đáp án đúng</span>";
                            }
                            
                            if (isCandidatePick && !isThisCorrect)
                            {
                                optStyle = "background: #FEF2F2; border: 2px solid #EF4444; font-weight: bold; color: #991B1B;";
                                badgeHtml = "<span class='badge badge-danger ml-2'><i class='fas fa-times mr-1'></i>Thí sinh chọn</span>";
                            }
                            else if (isCandidatePick && isThisCorrect)
                            {
                                badgeHtml += "<span class='badge badge-primary ml-1'><i class='fas fa-user-check mr-1'></i>Thí sinh chọn đúng</span>";
                            }

                            <div class="col-md-6 mb-2">
                                <div class="p-2 px-3 rounded d-flex align-items-center" style="@optStyle">
                                    <span class="mr-2 font-weight-bold">@opt.OptionLabel.</span>
                                    <span class="flex-grow-1">@opt.Content</span>
                                    @Html.Raw(badgeHtml)
                                </div>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(q.Explanation))
                    {
                        <div class="mt-2 p-2 px-3 rounded small text-dark" style="background-color: #FEF3C7; border-left: 4px solid #F59E0B;">
                            <i class="fas fa-lightbulb text-warning mr-1"></i>
                            <strong>Giải thích:</strong> @q.Explanation
                        </div>
                    }
                </div>
            </div>
        }

    </div>
</section>
