@using _2380600189.Exams.Dto
@model (QuestionDto Question, int ExamId)
@{
    var q = Model.Question;
}

<div class="card card-light border shadow-none mb-3">
    <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
        <span class="font-weight-bold text-primary" style="font-size: 1.05rem;">
            <i class="fas fa-question-circle mr-1"></i>Câu @q.QuestionNumber:
        </span>
        <a asp-action="EditQuestion" asp-route-id="@q.Id" asp-route-examId="@Model.ExamId" class="btn btn-xs btn-outline-secondary" title="Sửa lỗi câu hỏi hoặc đổi đáp án đúng">
            <i class="fas fa-pencil-alt mr-1"></i> Sửa câu @q.QuestionNumber
        </a>
    </div>
    <div class="card-body py-2">
        @if (!string.IsNullOrWhiteSpace(q.Content))
        {
            <p class="font-weight-bold mb-2 text-dark" style="font-size: 1.05rem;">@q.Content</p>
        }

        <div class="row">
            @foreach (var opt in q.Options.OrderBy(o => o.OrderIndex))
            {
                <div class="col-md-6 mb-2">
                    <div class="p-2 rounded border @(opt.IsCorrect ? "bg-success text-white font-weight-bold shadow-sm" : "bg-light text-dark")">
                        <span class="badge @(opt.IsCorrect ? "badge-light text-success" : "badge-secondary") mr-2 font-weight-bold px-2 py-1">
                            @opt.OptionLabel
                        </span>
                        @opt.Content
                        @if (opt.IsCorrect)
                        {
                            <i class="fas fa-check-circle ml-2 text-white float-right mt-1"></i>
                        }
                    </div>
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(q.Explanation))
        {
            <div class="mt-2 p-2 rounded bg-warning bg-opacity-25 border border-warning small text-dark" style="background-color: #fff9e6;">
                <i class="fas fa-lightbulb text-warning mr-1"></i>
                <strong>Gợi ý & Giải thích:</strong> @q.Explanation
            </div>
        }
    </div>
</div>
