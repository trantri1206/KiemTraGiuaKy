@using _2380600189.Exams.Dto
@model ExamStatisticDto
@{
    ViewBag.Title = "Thống kê đề thi: " + Model.ExamTitle;
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-7">
                <h1 class="m-0 text-dark">
                    <i class="fas fa-chart-line text-info mr-2"></i>Thống Kê & Phân Tích: @Model.ExamTitle
                </h1>
            </div>
            <div class="col-sm-5 text-right">
                <a asp-action="Index" class="btn btn-outline-secondary mr-2">
                    <i class="fas fa-list mr-1"></i> Danh sách
                </a>
                <a asp-action="Preview" asp-route-id="@Model.ExamId" class="btn btn-outline-primary">
                    <i class="fas fa-eye mr-1"></i> Xem trước đề
                </a>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        <!-- 4 KPI Cards -->
        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info shadow-sm">
                    <div class="inner">
                        <h3>@Model.TotalAttempts</h3>
                        <p class="font-weight-bold">Tổng lượt làm bài</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-users"></i>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-success shadow-sm">
                    <div class="inner">
                        <h3>@Model.AverageScore <sup style="font-size: 18px">/ 495</sup></h3>
                        <p class="font-weight-bold">Điểm trung bình</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-graduation-cap"></i>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning shadow-sm">
                    <div class="inner">
                        <h3>@Model.HighestScore <sup style="font-size: 18px">/ 495</sup></h3>
                        <p class="font-weight-bold">Điểm cao nhất</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-trophy"></i>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger shadow-sm">
                    <div class="inner">
                        <h3>@Model.LowestScore <sup style="font-size: 18px">/ 495</sup></h3>
                        <p class="font-weight-bold">Điểm thấp nhất</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-exclamation-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top 10 Most Missed Questions Card -->
        <div class="card card-outline card-danger shadow-sm mb-4">
            <div class="card-header bg-white">
                <h3 class="card-title font-weight-bold text-danger">
                    <i class="fas fa-fire-alt mr-2"></i>TOP 10 CÂU HỎI NHIỀU SINH VIÊN LÀM SAI NHẤT
                </h3>
                <div class="card-tools">
                    <span class="badge badge-danger px-3 py-2">Dữ liệu phân tích thực tế</span>
                </div>
            </div>
            <div class="card-body p-0 table-responsive">
                @if (Model.TopIncorrectQuestions.Count == 0)
                {
                    <div class="p-5 text-center text-muted">
                        <i class="fas fa-info-circle fa-3x mb-3 text-secondary d-block"></i>
                        Chưa có sinh viên nào làm bài thi này hoặc chưa có câu hỏi nào bị làm sai.
                    </div>
                }
                else
                {
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th style="width: 50px;" class="text-center">Top</th>
                                <th style="width: 90px;" class="text-center">Câu hỏi</th>
                                <th style="width: 90px;" class="text-center">Phần thi</th>
                                <th>Nội dung câu hỏi & Lời giải thích</th>
                                <th style="width: 200px;">Đáp án chuẩn</th>
                                <th style="width: 130px;" class="text-center">Lượt làm sai</th>
                                <th style="width: 150px;">Tỉ lệ sai</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rank = 1; }
                            @foreach (var q in Model.TopIncorrectQuestions)
                            {
                                <tr>
                                    <td class="text-center font-weight-bold">
                                        @if (rank == 1)
                                        {
                                            <span class="badge badge-danger p-2"><i class="fas fa-crown mr-1"></i>#1</span>
                                        }
                                        else if (rank <= 3)
                                        {
                                            <span class="badge badge-warning p-2 text-dark font-weight-bold">#@rank</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-light border p-2 text-dark">#@rank</span>
                                        }
                                    </td>
                                    <td class="text-center font-weight-bold text-primary">
                                        Câu @q.QuestionNumber
                                    </td>
                                    <td class="text-center">
                                        <span class="badge badge-info">Part @q.PartNumber</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(q.PassageTitle))
                                        {
                                            <div class="small text-muted font-italic mb-1">
                                                <i class="fas fa-paragraph mr-1"></i>@q.PassageTitle
                                            </div>
                                        }
                                        <div class="font-weight-bold text-dark mb-1">@q.Content</div>
                                        @if (!string.IsNullOrWhiteSpace(q.Explanation))
                                        {
                                            <div class="small p-2 rounded bg-warning bg-opacity-25 border border-warning text-dark" style="background-color: #fffbf0;">
                                                <i class="fas fa-lightbulb text-warning mr-1"></i>
                                                <strong>Gợi ý:</strong> @q.Explanation
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge badge-success px-2 py-1 font-weight-bold" style="font-size: 0.95rem;">
                                            <i class="fas fa-check mr-1"></i>@q.CorrectAnswer
                                        </span>
                                    </td>
                                    <td class="text-center font-weight-bold text-danger">
                                        @q.IncorrectCount / @q.TotalAttempts
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="progress flex-grow-1 mr-2" style="height: 14px;">
                                                <div class="progress-bar bg-danger" role="progressbar" style="width: @q.IncorrectPercentage%;" aria-valuenow="@q.IncorrectPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                            <strong class="text-danger small">@q.IncorrectPercentage%</strong>
                                        </div>
                                    </td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

    </div>
</section>
